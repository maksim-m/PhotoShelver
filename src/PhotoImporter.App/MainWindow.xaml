<Window x:Class="PhotoImporter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoImporter.App"
        xmlns:vm="clr-namespace:PhotoImporter.App.ViewModels"
        xmlns:controls="clr-namespace:PhotoImporter.App.Controls"
        Title="PhotoImporter" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#A0000000"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="BadgeIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- One thumbnail tile -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:MediaItemViewModel}">
            <StackPanel x:Name="Root" Width="150" Margin="0,0,8,8" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="600">
                <Border Height="100" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Extension}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource Secondary}" FontWeight="SemiBold"/>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <CheckBox AutomationProperties.AutomationId="TileCheck" AutomationProperties.Name="{Binding FileName}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanBeImported}" MinWidth="0" Padding="0"
                                  Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Импортировать этот файл"/>
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE714;" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Visibility="{Binding StatusGlyph, Converter={StaticResource NotNullToVis}}" ToolTip="{Binding StatusTip}">
                            <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource BadgeIcon}"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding FileName}" FontSize="11" Margin="2,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Clickable day header: collapses / expands the day -->
        <Style x:Key="GroupHeaderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,6,8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:HeaderRow}">
            <StackPanel Margin="0,10,8,6">
                <DockPanel>
                <CheckBox DockPanel.Dock="Left" MinWidth="0" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center"
                          IsChecked="{Binding GroupSelection, Mode=TwoWay}" IsEnabled="{Binding CanToggleSelection}"
                          ToolTip="{Binding SelectionTip}" ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.HelpText="Выбор дня" AutomationProperties.AutomationId="DayCheck" AutomationProperties.Name="{Binding Title}"/>
                <Button Style="{StaticResource GroupHeaderButton}" Margin="-6,0,0,0" AutomationProperties.AutomationId="DayHeader" AutomationProperties.Name="{Binding Title}"
                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" ToolTip="Свернуть или развернуть">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,2,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,2,0,0"/>
                    </StackPanel>
                </Button>
                </DockPanel>
                <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TileRow}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Source ================= -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Источник" Style="{StaticResource Header}"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Выбрать…" Margin="8,0,0,0" Padding="12,5" Command="{Binding BrowseSourceCommand}"/>
                    <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
                        <Button AutomationProperties.AutomationId="CollapseAll" AutomationProperties.Name="Свернуть все" Command="{Binding CollapseAllCommand}" Padding="8,3" Margin="0,0,6,0" ToolTip="Свернуть все дни">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock Text="Свернуть все" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="ExpandAll" AutomationProperties.Name="Развернуть все" Command="{Binding ExpandAllCommand}" Padding="8,3" ToolTip="Развернуть все дни">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock Text="Развернуть все" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <CheckBox Content="Включая подпапки" IsChecked="{Binding IncludeSubfolders}"
                              IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Visibility="{Binding IsCheckingDuplicates, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Secondary}" Margin="0,0,0,4"/>
                        <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Maximum="1" IsIndeterminate="{Binding ScanIndeterminate}" Height="4"/>
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button AutomationProperties.AutomationId="SelectAllNew" Content="Выбрать все новые" Padding="12,5" Margin="8,0,8,0" Command="{Binding SelectAllNewCommand}" IsEnabled="{Binding IsIdle}"/>
                            <Button AutomationProperties.AutomationId="SelectNone" Content="Снять все" Padding="12,5" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding IsIdle}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock AutomationProperties.AutomationId="Summary" Text="{Binding SummaryText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SkippedText}" Style="{StaticResource Secondary}" FontSize="12"
                                       Visibility="{Binding SkippedText, Converter={StaticResource NotNullToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <Grid>
                    <ItemsControl x:Name="ThumbGrid" ItemsSource="{Binding Rows}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  SizeChanged="ThumbGrid_SizeChanged">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock AutomationProperties.AutomationId="SourcePlaceholder" Text="{Binding SourcePlaceholder}" Style="{StaticResource Secondary}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SourcePlaceholder, Converter={StaticResource NotNullToVis}}"/>
                    <!-- While the source is being read there are no tiles yet: show a big progress ring in the middle -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <controls:ProgressRing Width="88" Height="88" Thickness="7" HorizontalAlignment="Center"
                                               Value="{Binding ScanProgress}" IsIndeterminate="{Binding ScanIndeterminate}"/>
                        <TextBlock Text="{Binding ScanStatus}" FontSize="15" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= Target ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Цель" Style="{StaticResource Header}"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Выбрать…" Margin="8,0,0,0" Padding="12,5" Command="{Binding BrowseTargetCommand}"/>
                    <TextBox Text="{Binding TargetPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Шаблон папок" Margin="0,0,0,4"/>
                <ComboBox AutomationProperties.AutomationId="Template" DockPanel.Dock="Top" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Pattern" IsEnabled="{Binding IsIdle}"
                          ItemsSource="{Binding TemplatePresets}"
                          Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Выберите вариант или введите свой. YYYY — год, YY — год (2 цифры), MM — месяц, MMM — месяц (Jan…Dec), DD — день, / — вложенная папка">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinWidth="260">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Example}" Style="{StaticResource Secondary}" Margin="24,0,0,0"/>
                                <TextBlock Text="{Binding Pattern}" FontWeight="SemiBold"/>
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TemplateExample}" Style="{StaticResource Secondary}" Margin="0,4,0,0"
                           Visibility="{Binding TemplateExample, Converter={StaticResource NotNullToVis}}"/>
                <TextBlock AutomationProperties.AutomationId="TemplateError" DockPanel.Dock="Top" Text="{Binding TemplateError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Visibility="{Binding TemplateError, Converter={StaticResource NotNullToVis}}"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0" Visibility="{Binding TemplateWarning, Converter={StaticResource NotNullToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Margin="0,2,6,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    <TextBlock AutomationProperties.AutomationId="TemplateWarning" Text="{Binding TemplateWarning}" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="YYYY · YY · MM · MMM · DD · / — новый уровень" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,12"/>

                <CheckBox AutomationProperties.AutomationId="ShowFullTree" DockPanel.Dock="Bottom" Content="Показать всё дерево" IsChecked="{Binding ShowFullTree}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding LeftoversText, Converter={StaticResource NotNullToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            <TextBlock AutomationProperties.AutomationId="Leftovers" Text="{Binding LeftoversText}" TextWrapping="Wrap"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Показать" Padding="12,4" Margin="0,0,8,0" Command="{Binding ShowLeftoversCommand}"/>
                            <Button AutomationProperties.AutomationId="DeleteLeftovers" Content="Удалить" Padding="12,4" Command="{Binding DeleteLeftoversCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <TreeView AutomationProperties.AutomationId="TargetTree" x:Name="TargetTree" ItemsSource="{Binding Tree}" BorderThickness="0" Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}"/>
                                    <Border CornerRadius="4" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="NEW" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock AutomationProperties.AutomationId="TreePlaceholder" Text="{Binding TreePlaceholder}" Style="{StaticResource Secondary}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                               Visibility="{Binding TreePlaceholder, Converter={StaticResource NotNullToVis}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= Notice bar ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding DisplayNotice, Converter={StaticResource NotNullToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button AutomationProperties.AutomationId="SwitchToCopy" DockPanel.Dock="Right" Content="Копировать вместо перемещения" Padding="12,4" Command="{Binding SwitchToCopyCommand}"
                        Visibility="{Binding NoticeHasAction, Converter={StaticResource BoolToVis}}"/>
                <TextBlock AutomationProperties.AutomationId="Notice" Text="{Binding DisplayNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ================= Bottom bar ================= -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                <RadioButton AutomationProperties.AutomationId="ModeMove" Content="Переместить" IsChecked="{Binding IsMoveMode}" Margin="0,0,16,0" GroupName="Mode"/>
                <RadioButton AutomationProperties.AutomationId="ModeCopy" Content="Копировать" IsChecked="{Binding IsCopyMode}" GroupName="Mode"/>
            </StackPanel>
            <Button AutomationProperties.AutomationId="Import" DockPanel.Dock="Right" Content="Импорт" Padding="32,6" Margin="12,0,0,0" FontWeight="SemiBold"
                    Style="{DynamicResource AccentButtonStyle}" Command="{Binding ImportCommand}"/>
            <Button AutomationProperties.AutomationId="CancelImport" DockPanel.Dock="Right" Content="Отмена" Padding="16,6" Margin="12,0,0,0" Command="{Binding CancelImportCommand}"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"/>
            <StackPanel VerticalAlignment="Center" Margin="32,0,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                <TextBlock AutomationProperties.AutomationId="ImportStatus" Text="{Binding ImportStatus}" Style="{StaticResource Secondary}" Margin="0,0,0,4"/>
                <ProgressBar Value="{Binding ImportProgress, Mode=OneWay}" Maximum="1" Height="4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
