<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PhotoShelver</AssemblyName>
    <RootNamespace>PhotoShelver.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Local builds are "0.0.0-dev"; releases get their version from the tag (.github/workflows/release.yml). -->
    <Version>0.0.0-dev</Version>
    <!-- Restored the same way in Debug and Release, so that one lock file (packages.lock.json) serves both: the
         win-x64 runtime, and the single-file setting (it brings the single-file analyzer package). Both only take
         effect on publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <Using Include="System.IO" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoShelver.Core\PhotoShelver.Core.csproj" />
  </ItemGroup>
</Project>
